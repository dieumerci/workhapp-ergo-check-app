# Every environment variable the application reads. Copy to `.env` for local use
# (git-ignored); in production set them on the platform. Nothing here is required
# for local development: every variable has a sensible default.

# --- Database ---------------------------------------------------------------
# Production: set by the Postgres add-on. Locally the databases are
# workhappy_development / workhappy_test over the default socket.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Demo data --------------------------------------------------------------
# Password for the four seeded demo admins. Defaults to a documented demo value,
# so on a hosted demo ALWAYS set your own.
# DEMO_ADMIN_PASSWORD=choose-something-long
# Seeds are skipped in production unless this is "true" (a hosted demo only).
# ALLOW_DEMO_SEED=true

# --- Exports ----------------------------------------------------------------
# Time budget per export in seconds before it fails with "try a narrower range".
# EXPORT_MAX_SECONDS=300

# Where generated CSV files live. "local" (default) suits one host with a
# persistent volume. Heroku-like platforms have an ephemeral disk: use "amazon".
# ACTIVE_STORAGE_SERVICE=amazon
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1

# --- Internal pages ---------------------------------------------------------
# The Release plan and Safeguards pages are internal ops notes. They are shown in
# development and test, and hidden (404) in production unless this is "true"
# (for example on a demo deployment).
# SHOW_OPS_PAGES=true

# --- Runtime ----------------------------------------------------------------
# SECRET_KEY_BASE=            # production: `bin/rails secret` (or set RAILS_MASTER_KEY instead)
# RAILS_MASTER_KEY=            # contents of config/master.key (production)
# RAILS_LOG_LEVEL=info         # never run production at debug: it logs SQL and parameters
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=2            # Puma workers
# JOB_CONCURRENCY=1            # Solid Queue worker processes
# PORT=3000                    # Railway and Heroku provide it themselves
# SKIP_DB_PREPARE=1            # production: do not run db:prepare db:seed when the web process boots
# SOLID_QUEUE_IN_PUMA=1        # run the job worker inside the web process (single-dyno setups)

# --- Status backfill (plan only; see db/release_plan/RUNBOOK.md) ------------
# Set on the command line for one run, not in a file:
#   CONFIRM=yes BACKUP_TAKEN=yes BATCH_SIZE=5000 PAUSE=0.2 FROM_ID=<id>

# --- Benchmarks (development only) ------------------------------------------
# ROWS=100000                  # bin/rails perf:seed
# SIZES=5000,25000,100000      # bin/rails perf:report

# --- Railway (see RAILWAY_SETUP.md for the full list) -----------------------
# DATABASE_URL=${{Postgres.DATABASE_URL}}   # a Railway reference to the Postgres service
# RAILWAY_RUN_UID=0                          # only when a Volume is mounted at /rails/storage
