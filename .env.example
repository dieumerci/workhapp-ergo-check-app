# Every environment variable the application reads. Copy to `.env` for local use
# (git-ignored); in production set them on the platform. Nothing here is required
# for local development: every variable has a sensible default.

# --- Database ---------------------------------------------------------------
# Production: required. Heroku sets it when a Postgres add-on is attached; on
# Railway add the reference `DATABASE_URL=${{Postgres.DATABASE_URL}}` to the app
# service. Locally the databases are workhappy_development / workhappy_test over
# the default socket, so leave it unset.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Secrets (production) ---------------------------------------------------
# SECRET_KEY_BASE=             # `bin/rails secret`; or set RAILS_MASTER_KEY instead
# RAILS_MASTER_KEY=            # contents of config/master.key

# --- Demo data --------------------------------------------------------------
# Seeds create the four demo admins listed in the README. In production they are
# skipped unless ALLOW_DEMO_SEED is on (true, 1, yes or on), so a real deployment
# never gets demo accounts by accident. While it is on, every run re-applies
# DEMO_ADMIN_PASSWORD to those accounts; it defaults to the value in the README,
# so on a hosted demo ALWAYS set your own (at least 12 characters).
# ALLOW_DEMO_SEED=true
# DEMO_ADMIN_PASSWORD=choose-something-long

# --- Exports ----------------------------------------------------------------
# Time budget per export in seconds before it fails with "try a narrower range".
# EXPORT_MAX_SECONDS=300

# --- Where export files are stored ------------------------------------------
# Default: the local disk (`storage/`), which suits a laptop or a host with a
# persistent volume. On a platform whose disk is wiped on every deploy the files
# vanish and old downloads give a 404, so either mount a volume at /rails/storage
# (on Railway also set RAILWAY_RUN_UID=0, because the image runs as a non-root
# user) or switch to Amazon S3 with all five lines below.
# On Heroku (DYNO is set) the app refuses to boot with the local disk.
# The S3 path is covered by tests that use the AWS SDK's stubbed client (config,
# upload through the S3 service, signed one-minute download link); it has not
# been run against a real bucket, so do one export after configuring one.
# ACTIVE_STORAGE_SERVICE=amazon
# AWS_S3_BUCKET=a-private-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# RAILWAY_RUN_UID=0

# --- Internal pages ---------------------------------------------------------
# The Release plan and Safeguards pages are internal ops notes. They are shown in
# development and test, and hidden (404) in production unless this is "true"
# (for example on a demo deployment).
# SHOW_OPS_PAGES=true

# --- Runtime ----------------------------------------------------------------
# RAILS_LOG_LEVEL=info         # never run production at debug: it logs SQL and parameters
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=2            # Puma workers
# JOB_CONCURRENCY=1            # Solid Queue worker processes
# PORT=3000                    # Railway and Heroku provide it themselves
# SOLID_QUEUE_IN_PUMA=1        # run the job worker inside the web process (single-service hosting)
# SKIP_DB_PREPARE=1            # production: do not run db:prepare db:seed when the web process boots

# --- Status backfill (plan only; see SOLUTION.md, section 6) ----------------
# Set on the command line for one run, not in a file:
#   CONFIRM=yes BACKUP_TAKEN=yes BATCH_SIZE=5000 PAUSE=0.2 FROM_ID=<id>

# --- Benchmarks (development only) ------------------------------------------
# ROWS=100000                  # bin/rails perf:seed
# SIZES=5000,25000,100000      # bin/rails perf:report
